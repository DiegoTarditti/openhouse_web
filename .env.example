# Copiar a .env (no se sube al repo). Nada de esto es obligatorio en desarrollo.
ENTORNO=desarrollo            # "produccion" exige SECRET_KEY y activa cookies seguras
SECRET_KEY=
SITIO_URL=https://www.openhouse.com.ar
SITIO_NOMBRE=Open House
SITIO_DIRECCION=
SITIO_TELEFONO=
SITIO_WHATSAPP=5493410000000  # solo números, con código de país
SITIO_EMAIL=
SITIO_HORARIO=
# Correo de las consultas (sin SMTP_HOST se registran en el log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONSULTAS_DESTINO=
# Origen de las propiedades: "simulada" (hoy) o "tokko" (próxima semana)
FUENTE_PROPIEDADES=simulada
TOKKO_API_KEY=
